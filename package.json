{
  "name": "lint-prepush",
  "version": "3.0.3",
  "description": "Run linters on committed files in a Branch🔬",
  "author": "“Theenadayalan” <“puduvai.theena@gmail.com”>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "lint-prepush": "./dist/lint-prepush.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-prepush": {
    "base": "master",
    "tasks": {
      "*.ts": [
        "eslint"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cosmiconfig": "^9.0.0",
    "debug": "^4.4.3",
    "execa": "^9.6.1",
    "listr2": "^10.2.1",
    "micromatch": "^4.0.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theenadayalank/lint-prepush.git"
  },
  "bugs": {
    "url": "https://github.com/theenadayalank/lint-prepush/issues"
  },
  "homepage": "https://github.com/theenadayalank/lint-prepush",
  "keywords": [
    "lint",
    "lint-prepush",
    "prepush",
    "husky",
    "linter",
    "git",
    "hooks"
  ]
}
