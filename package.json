{
  "name": "lint-prepush",
  "version": "3.0.3",
  "description": "Run linters on committed files in a Branch🔬",
  "author": "“Theenadayalan” <“puduvai.theena@gmail.com”>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lint-prepush": "./dist/lint-prepush.js"
  },
  "scripts": {
    "lint": "node_modules/.bin/eslint",
    "lint:fix": "yarn lint --fix",
    "build": "tsup",
    "test": "mocha tests/",
    "verify": "yarn build && yarn lint . && yarn test",
    "prepare": "husky"
  },
  "lint-prepush": {
    "base": "develop",
    "tasks": {
      "*.js": [
        "node_modules/.bin/eslint"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.2.2",
    "eslint": "^10.0.0",
    "eslint-plugin-mocha": "^11.2.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "mocha": "^10.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cosmiconfig": "^9.0.0",
    "debug": "^4.4.3",
    "dedent": "^1.7.1",
    "execa": "^9.6.1",
    "file-system-cache": "^2.4.7",
    "listr": "^0.14.3",
    "log-symbols": "^7.0.1",
    "micromatch": "^4.0.8",
    "node-which": "^1.0.0",
    "npm-which": "^3.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theenadayalank/lint-prepush.git"
  },
  "bugs": {
    "url": "https://github.com/theenadayalank/lint-prepush/issues"
  },
  "homepage": "https://github.com/theenadayalank/lint-prepush",
  "keywords": [
    "lint",
    "lint-prepush",
    "prepush",
    "husky",
    "linter",
    "git",
    "hooks"
  ]
}
